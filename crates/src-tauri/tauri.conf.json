{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gilvave",
  "version": "0.0.0",
  "identifier": "com.admin.gilvave",
  "build": {
    "beforeDevCommand": "trunk serve --config ui/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release --config ui/Trunk.toml",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "gilvave",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
